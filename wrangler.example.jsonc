// Reference only. Keep your existing working wrangler.jsonc/toml instead of overwriting it.
{
  "name": "swarna-finance",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-23",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [{ "binding": "DB", "database_name": "REPLACE_WITH_YOUR_EXISTING_DB_NAME", "database_id": "REPLACE_WITH_YOUR_EXISTING_DB_ID" }],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "REPLACE_WITH_YOUR_EXISTING_PHOTOS_BUCKET" }]
}

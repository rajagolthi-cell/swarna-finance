// Safe default: a NEW STAGING Worker and database; DO NOT replace production IDs/secrets.
// Set your real staging D1 ID and master email before running wrangler deploy.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "swarna-finance-complete-staging",
  "main": "./src/worker.js",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "swarna-finance-complete-staging-db",
      "database_id": "REPLACE_WITH_STAGING_D1_UUID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "swarna-finance-complete-staging-photos"
    }
  ],
  "vars": {
    "RESEND_FROM": "Swarna Finance <otp@swarnalive.com>",
    "MASTER_EMAIL": "REPLACE_WITH_MASTER_ADMIN_EMAIL",
    "GOOGLE_REDIRECT_URI": "",
    "PUBLIC_ORIGIN": "",
    "ADMIN_HOSTNAME": "admin.swarnalive.com"
  },
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}


{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "swarna-finance",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-16",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "vars": {
    "GOOGLE_REDIRECT_URI": "https://swarnalive.com/api/drive/callback",
    "RESEND_FROM": "Swarna Finance <otp@swarnalive.com>"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "swarna-finance-db",
      "database_id": "e4a10973-3579-4d8a-8188-a67da217d7bb"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "swarna-finance-private-photos"
    }
  ]
}
